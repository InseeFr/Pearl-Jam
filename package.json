{
  "name": "pearl",
  "version": "2.17.2",
  "private": true,
  "type": "module",
  "dependencies": {
    "@babel/runtime": "7.26.10",
    "@fontsource/montserrat": "^5.3.0",
    "@maverick-js/signals": "^5.11.5",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/styles": "^5.18.0",
    "@mui/utils": "^7.3.11",
    "@mui/x-date-pickers": "^6.20.2",
    "axios": "^1.20.0",
    "date-fns": "^3.6.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^1.1.7",
    "keycloak-js": "^26.2.4",
    "postcss": "8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "react-swipeable-views": "^0.14.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "test": "vitest",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "pre-push": "stylelint \"src/**/*.css\"  && pnpm test --watch=false",
    "postinstall": "vite-envs update-types",
    "openapi": "orval --config ./orval.config.mjs",
    "playwright": "npx playwright test --ui-port=8888 --ui-host=localhost"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "prettier",
      "plugin:react-hooks/recommended",
      "plugin:jsx-a11y/recommended",
      "plugin:import/warnings"
    ],
    "plugins": [
      "prettier",
      "jsx-a11y"
    ],
    "rules": {
      "prettier/prettier": [
        1,
        {
          "arrowParens": "avoid"
        }
      ]
    },
    "globals": {
      "fetch": true,
      "window": true,
      "document": true,
      "navigator": true
    },
    "settings": {
      "import/resolver": {
        "node": {
          "paths": [
            "src"
          ]
        }
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "es5",
    "endOfLine": "auto",
    "arrowParens": "avoid"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@emotion/react": "^11.14.0",
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "5.2.1",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-swipeable-views": "^0.13.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "copy-and-watch": "^0.1.8",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "orval": "^8.30.0",
    "prettier": "^3.9.6",
    "react-hook-form": "^7.87.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "uuid": "^11.1.1",
    "vite": "^6.4.3",
    "vite-envs": "^4.7.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^3.25.76"
  }
}
